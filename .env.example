# Kopie als .env anlegen (wird nicht eingecheckt).
TALK4ME_AUTH=1                                   # Konten einschalten: Registrierung per E-Mail-Link, je Konto eine eigene Datenbank
TALK4ME_BASE_URL=https://talk4me.bekerh.ddns.net # Adresse, die im Link der E-Mail steht
TALK4ME_ADOPT_EMAIL=                             # dieses Konto übernimmt beim Anlegen die bisherige Datenbank data/talk4me.db
TALK4ME_SMTP_HOST=smtp.example.org               # ohne Mailserver landet der Link nur im Container-Log (docker logs talk4me)
TALK4ME_SMTP_PORT=587                            # 587 = STARTTLS, 465 = SSL
TALK4ME_SMTP_USER=
TALK4ME_SMTP_PASSWORD=
TALK4ME_SMTP_FROM=Talk4Me <talk4me@example.org>
